{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k3-track",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/*.html",
      "/*.json",
      "/assets/k3-track-og-final-v2.jpg"
    ]
  }
}
